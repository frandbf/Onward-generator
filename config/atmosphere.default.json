{
  "$schema": "./atmosphere.schema.json",
  "version": "0.1.0",
  "presets": {
    "golden_hour": {
      "description": "Warm low sun across the streets, cool trilight shade, warm haze",
      "sun": { "elevation_deg": 30, "azimuth": "streets", "color": "#FFE0B8", "intensity": 1.4, "shadow_angle_deg": 1.5 },
      "ambient": { "mode": "trilight", "sky": "#8A9BB3", "equator": "#9A9080", "ground": "#5A5044" },
      "ao": { "max_distance_m": 1.5, "exponent_indirect": 1.0, "exponent_direct": 0.2 },
      "indirect_intensity": 2.0,
      "fog": { "color": "#E8D2B4" },
      "lightmap_texels_per_m_core": 14,
      "grime": 1.0,
      "wall_desaturation": 0.08,
      "wall_value_max": 0.85
    },
    "overcast": {
      "description": "High soft sun, flat grey ambient, grey haze",
      "sun": { "elevation_deg": 55, "azimuth": 150, "color": "#DDE3EA", "intensity": 0.7, "shadow_angle_deg": 8 },
      "ambient": { "mode": "flat", "sky": "#9AA3AD" },
      "ao": { "max_distance_m": 1.5, "exponent_indirect": 1.0, "exponent_direct": 0.0 },
      "fog": { "color": "#C9CFD6" },
      "lightmap_texels_per_m_core": 10,
      "grime": 1.2,
      "wall_desaturation": 0.05,
      "wall_value_max": 0.85
    }
  }
}
