{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "onward-generator street moods",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "default", "moods"],
  "properties": {
    "schema": { "const": "onward_generator.street_moods" },
    "schema_version": { "const": "0.4.0" },
    "description": { "type": "string" },
    "default": { "type": "string", "pattern": "^[a-z][a-z_]*$" },
    "moods": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z_]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["note", "vines", "planted_trees", "wrecks", "conditions", "categories", "wall_decals_excluded", "terraces", "awnings", "cover"],
        "properties": {
          "note": { "type": "string", "minLength": 1 },
          "vines": { "description": "Factor on the profile's vines", "type": "number", "minimum": 0, "maximum": 1 },
          "planted_trees": { "description": "Factor on the trees overgrow plants where OSM maps none; mapped trees always stand", "type": "number", "minimum": 0, "maximum": 1 },
          "wrecks": { "description": "Factor on the profile's procedural car wrecks", "type": "number", "minimum": 0, "maximum": 1 },
          "conditions": {
            "description": "Library props kept, by their condition; a prop without one is kept; null keeps every condition",
            "oneOf": [
              { "type": "null" },
              { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["intact", "worn", "damaged", "wrecked", "burned"] } }
            ]
          },
          "categories": {
            "description": "Factor on the rule caps of a prop category",
            "type": "object",
            "propertyNames": { "enum": ["barriers", "facade", "furniture", "structures", "vegetation", "vehicles", "waste"] },
            "additionalProperties": { "type": "number", "minimum": 0, "maximum": 4 }
          },
          "wall_decals_excluded": {
            "description": "Wall decal kinds the mood leaves out; war damage (map.json damage) adds its own kinds regardless",
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z_]*$" }
          },
          "terraces": { "description": "Café tables, chairs, a menu board and a planter before each bar of a pedestrian street or plaza (config/terraces.json)", "type": "boolean" },
          "awnings": { "description": "Striped awnings under the fascia signs of the shops (config/awnings.json)", "type": "boolean" },
          "cover": {
            "description": "The library props perf cover may stand on a long sightline (plan increment 5): their roles, and their conditions (a prop without one is kept; null keeps every condition). null keeps the cover stage's own roles, of any condition",
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["roles", "conditions"],
                "properties": {
                  "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z_]*$" } },
                  "conditions": {
                    "oneOf": [
                      { "type": "null" },
                      { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["intact", "worn", "damaged", "wrecked", "burned"] } }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
