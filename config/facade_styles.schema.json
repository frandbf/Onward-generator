{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onward_generator.facade_styles.schema.json",
  "title": "Facade styles for the trim-sheet atlas (ADR-020)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "default_style", "selection", "styles"],
  "properties": {
    "schema": { "const": "onward_generator.facade_styles" },
    "schema_version": { "const": "0.1.0" },
    "description": { "type": "string" },
    "default_style": { "type": "string", "pattern": "^[a-z_]+$" },
    "selection": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["style", "boxes"],
        "properties": {
          "style": { "type": "string", "pattern": "^[a-z_]+$" },
          "note": { "type": "string" },
          "boxes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "description": "[lat_min, lat_max, lon_min, lon_max] in WGS84 degrees",
              "prefixItems": [
                { "type": "number", "minimum": -90, "maximum": 90 },
                { "type": "number", "minimum": -90, "maximum": 90 },
                { "type": "number", "minimum": -180, "maximum": 180 },
                { "type": "number", "minimum": -180, "maximum": 180 }
              ],
              "minItems": 4,
              "maxItems": 4
            }
          }
        }
      }
    },
    "styles": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z_]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["note", "atlas"],
        "properties": {
          "note": { "type": "string" },
          "atlas": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/atlas" }] }
        }
      }
    }
  },
  "$defs": {
    "rgb": {
      "type": "array",
      "items": { "type": "number", "minimum": 0, "maximum": 1 },
      "minItems": 3,
      "maxItems": 3
    },
    "px": { "type": "integer", "minimum": 16, "maximum": 4096 },
    "metres": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
    "atlas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size_px", "height_px", "gutter_px", "fit_row_px", "fit_cell_px", "cornice_px", "zocalo_px", "stone_px",
        "wall_repeat_m", "zocalo_m", "zocalo_repeat_m", "cornice_repeat_m", "stone_repeat_m", "storey_ref_m", "max_band_m",
        "walls", "scenic_walls", "sources", "source_tile_m", "zocalo_color", "cornice_color", "stone_color",
        "window_families", "door_colors", "grime", "tones", "dress"
      ],
      "properties": {
        "size_px": { "enum": [1024, 2048] },
        "height_px": { "enum": [1024, 2048, 4096] },
        "gutter_px": { "type": "integer", "minimum": 2, "maximum": 32 },
        "fit_row_px": { "$ref": "#/$defs/px" },
        "fit_cell_px": { "$ref": "#/$defs/px" },
        "cornice_px": { "$ref": "#/$defs/px" },
        "zocalo_px": { "$ref": "#/$defs/px" },
        "stone_px": { "$ref": "#/$defs/px" },
        "wall_repeat_m": { "$ref": "#/$defs/metres" },
        "zocalo_m": { "$ref": "#/$defs/metres" },
        "zocalo_repeat_m": { "$ref": "#/$defs/metres" },
        "cornice_repeat_m": { "$ref": "#/$defs/metres" },
        "stone_repeat_m": { "$ref": "#/$defs/metres" },
        "storey_ref_m": { "$ref": "#/$defs/metres" },
        "max_band_m": { "$ref": "#/$defs/metres" },
        "walls": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "enum": ["plaster", "ashlar", "brick"] }
        },
        "scenic_walls": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plaster", "stone", "brick"],
          "properties": {
            "plaster": { "type": "string" },
            "stone": { "type": "string" },
            "brick": { "type": "string" }
          }
        },
        "source_tile_m": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plaster", "stone", "brick"],
          "properties": {
            "plaster": { "$ref": "#/$defs/metres" },
            "stone": { "$ref": "#/$defs/metres" },
            "brick": { "$ref": "#/$defs/metres" }
          }
        },
        "zocalo_color": { "$ref": "#/$defs/rgb" },
        "cornice_color": { "$ref": "#/$defs/rgb" },
        "stone_color": { "$ref": "#/$defs/rgb" },
        "window_families": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["frame", "shutter", "closed"],
            "properties": {
              "frame": { "$ref": "#/$defs/rgb" },
              "shutter": { "$ref": "#/$defs/rgb" },
              "closed": {
                "type": "array",
                "items": { "type": "number", "minimum": 0, "maximum": 0.9 },
                "minItems": 1,
                "maxItems": 3
              }
            }
          }
        },
        "door_colors": { "type": "array", "items": { "$ref": "#/$defs/rgb" }, "minItems": 1, "maxItems": 3 },
        "tones": {
          "description": "One wall strip per tone and wall colour: the colour times each tone. A building takes one tone by sha256 of its parcel.",
          "type": "array", "items": { "$ref": "#/$defs/rgb" }, "minItems": 1, "maxItems": 3
        },
        "dress": {
          "description": "Share of buildings, by sha256 of their parcel, with a stone zocalo, a cornice under the parapet and a string course at every storey; the rest keep the wall strip there.",
          "type": "object",
          "additionalProperties": false,
          "required": ["zocalo_share", "cornice_share", "course_share"],
          "properties": {
            "zocalo_share": { "type": "number", "minimum": 0, "maximum": 1 },
            "cornice_share": { "type": "number", "minimum": 0, "maximum": 1 },
            "course_share": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "grime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["streaks_per_strip", "streak_dark", "streak_length_m", "under_course_dark", "base_splash_dark", "base_splash_m", "mottle"],
          "properties": {
            "streaks_per_strip": { "type": "integer", "minimum": 0, "maximum": 400 },
            "streak_dark": { "type": "number", "minimum": 0, "maximum": 0.5 },
            "streak_length_m": {
              "type": "array",
              "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
              "minItems": 2,
              "maxItems": 2
            },
            "under_course_dark": { "type": "number", "minimum": 0, "maximum": 0.6 },
            "base_splash_dark": { "type": "number", "minimum": 0, "maximum": 0.6 },
            "base_splash_m": { "$ref": "#/$defs/metres" },
            "mottle": { "type": "number", "minimum": 0, "maximum": 0.2 }
          }
        }
      }
    }
  }
}
