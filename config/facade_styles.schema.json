{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onward_generator.facade_styles.schema.json",
  "title": "Facade styles for the trim-sheet atlas (ADR-020)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "default_style", "selection", "styles"],
  "properties": {
    "schema": { "const": "onward_generator.facade_styles" },
    "schema_version": { "const": "0.1.0" },
    "description": { "type": "string" },
    "default_style": { "type": "string", "pattern": "^[a-z_]+$" },
    "selection": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["style", "boxes"],
        "properties": {
          "style": { "type": "string", "pattern": "^[a-z_]+$" },
          "note": { "type": "string" },
          "boxes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "description": "[lat_min, lat_max, lon_min, lon_max] in WGS84 degrees",
              "prefixItems": [
                { "type": "number", "minimum": -90, "maximum": 90 },
                { "type": "number", "minimum": -90, "maximum": 90 },
                { "type": "number", "minimum": -180, "maximum": 180 },
                { "type": "number", "minimum": -180, "maximum": 180 }
              ],
              "minItems": 4,
              "maxItems": 4
            }
          }
        }
      }
    },
    "styles": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z_]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["note", "atlas"],
        "properties": {
          "note": { "type": "string" },
          "atlas": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/atlas" }] }
        }
      }
    }
  },
  "$defs": {
    "regional_table": {
      "description": "Opt-in atlas recipes for styles whose atlas is null in facade_styles.json (plan D1, ADR-020 amendment). Read only with map.json regional_facades: true or materials apply --regional-facades.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "atlases"],
      "properties": {
        "schema": { "const": "onward_generator.facade_styles_regional" },
        "schema_version": { "const": "0.1.0" },
        "description": { "type": "string" },
        "atlases": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z_]+$" },
          "additionalProperties": { "$ref": "#/$defs/atlas" }
        }
      }
    },
    "rgb": {
      "type": "array",
      "items": { "type": "number", "minimum": 0, "maximum": 1 },
      "minItems": 3,
      "maxItems": 3
    },
    "px": { "type": "integer", "minimum": 16, "maximum": 4096 },
    "metres": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
    "atlas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size_px", "height_px", "gutter_px", "fit_row_px", "fit_cell_px", "cornice_px", "zocalo_px", "stone_px",
        "wall_repeat_m", "zocalo_m", "zocalo_repeat_m", "cornice_repeat_m", "stone_repeat_m", "storey_ref_m", "max_band_m",
        "walls", "scenic_walls", "sources", "source_tile_m", "zocalo_color", "cornice_color", "stone_color",
        "window_families", "door_colors", "grime", "tones", "dress"
      ],
      "properties": {
        "size_px": { "enum": [1024, 2048] },
        "height_px": { "enum": [1024, 2048, 4096] },
        "gutter_px": { "type": "integer", "minimum": 2, "maximum": 32 },
        "fit_row_px": { "$ref": "#/$defs/px" },
        "fit_cell_px": { "$ref": "#/$defs/px" },
        "cornice_px": { "$ref": "#/$defs/px" },
        "zocalo_px": { "$ref": "#/$defs/px" },
        "stone_px": { "$ref": "#/$defs/px" },
        "wall_repeat_m": { "$ref": "#/$defs/metres" },
        "zocalo_m": { "$ref": "#/$defs/metres" },
        "zocalo_repeat_m": { "$ref": "#/$defs/metres" },
        "cornice_repeat_m": { "$ref": "#/$defs/metres" },
        "stone_repeat_m": { "$ref": "#/$defs/metres" },
        "storey_ref_m": { "$ref": "#/$defs/metres" },
        "max_band_m": { "$ref": "#/$defs/metres" },
        "walls": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "enum": ["plaster", "ashlar", "brick"] }
        },
        "scenic_walls": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "wall_tints": {
          "description": "Plan Q3: the linear RGB tint of a wall strip, in place of the colour of the generation palette, for a style whose walls are one material whatever the palette says (Paris limestone). Every key must be a wall of walls.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/rgb" }
        },
        "estimated_walls": {
          "description": "A wall the generation palette estimated (facade.materials.wall_origin generated), drawn in the strip of another wall: Paris takes no estimated brick. A building whose OSM building:material sets its wall keeps it. Every key and value must be a wall of walls.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plaster", "stone", "brick"],
          "properties": {
            "plaster": { "type": "string" },
            "stone": { "type": "string" },
            "brick": { "type": "string" }
          }
        },
        "source_tile_m": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plaster", "stone", "brick"],
          "properties": {
            "plaster": { "$ref": "#/$defs/metres" },
            "stone": { "$ref": "#/$defs/metres" },
            "brick": { "$ref": "#/$defs/metres" }
          }
        },
        "zocalo_color": { "$ref": "#/$defs/rgb" },
        "cornice_color": { "$ref": "#/$defs/rgb" },
        "stone_color": { "$ref": "#/$defs/rgb" },
        "window_families": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["frame", "shutter", "closed"],
            "properties": {
              "kind": {
                "description": "How the cell is painted: shutter (a roller shutter under its box, the default), casement (two leaves under a transom), sash (two sashes with glazing bars) or grille (iron bars over the glass, timber leaves behind). closed is the share of the glass the shutter, an inner blind (casement, sash) or the leaves (grille) hide; shutter is that blind's or those leaves' colour.",
                "enum": ["shutter", "casement", "sash", "grille"]
              },
              "iron": { "$ref": "#/$defs/rgb" },
              "frame": { "$ref": "#/$defs/rgb" },
              "shutter": { "$ref": "#/$defs/rgb" },
              "closed": {
                "type": "array",
                "items": { "type": "number", "minimum": 0, "maximum": 0.9 },
                "minItems": 1,
                "maxItems": 3
              }
            },
            "if": { "required": ["kind"], "properties": { "kind": { "const": "grille" } } },
            "then": { "required": ["iron"] }
          }
        },
        "eras": {
          "description": "Era bands (plan D1, ADR-027 amendment): for a building whose record has an observed facade.typology.era, the tones and window families it may take and the dress shares that change. The era is observed; the band is an estimate. A building with no observed era, or an era with no band, keeps the style's own look.",
          "type": "object",
          "propertyNames": { "enum": ["pre_1900", "1900_1939", "1940_1959", "1960_1979", "1980_1999", "2000_plus"] },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tones", "window_families"],
            "properties": {
              "tones": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1, "maxItems": 3, "uniqueItems": true },
              "window_families": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1, "maxItems": 4, "uniqueItems": true },
              "dress": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "zocalo_share": { "type": "number", "minimum": 0, "maximum": 1 },
                  "cornice_share": { "type": "number", "minimum": 0, "maximum": 1 },
                  "course_share": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            }
          }
        },
        "door_colors": { "type": "array", "items": { "$ref": "#/$defs/rgb" }, "minItems": 1, "maxItems": 3 },
        "tones": {
          "description": "One wall strip per tone and wall colour: the colour times each tone. A building takes one tone by sha256 of its parcel.",
          "type": "array", "items": { "$ref": "#/$defs/rgb" }, "minItems": 1, "maxItems": 3
        },
        "dress": {
          "description": "Share of buildings, by sha256 of their parcel, with a stone zocalo, a cornice under the parapet and a string course at every storey; the rest keep the wall strip there.",
          "type": "object",
          "additionalProperties": false,
          "required": ["zocalo_share", "cornice_share", "course_share"],
          "properties": {
            "zocalo_share": { "type": "number", "minimum": 0, "maximum": 1 },
            "cornice_share": { "type": "number", "minimum": 0, "maximum": 1 },
            "course_share": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "grime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["streaks_per_strip", "streak_dark", "streak_length_m", "under_course_dark", "base_splash_dark", "base_splash_m", "mottle"],
          "properties": {
            "streaks_per_strip": { "type": "integer", "minimum": 0, "maximum": 400 },
            "streak_dark": { "type": "number", "minimum": 0, "maximum": 0.5 },
            "streak_length_m": {
              "type": "array",
              "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
              "minItems": 2,
              "maxItems": 2
            },
            "under_course_dark": { "type": "number", "minimum": 0, "maximum": 0.6 },
            "base_splash_dark": { "type": "number", "minimum": 0, "maximum": 0.6 },
            "base_splash_m": { "$ref": "#/$defs/metres" },
            "mottle": { "type": "number", "minimum": 0, "maximum": 0.2 }
          }
        }
      }
    }
  }
}
