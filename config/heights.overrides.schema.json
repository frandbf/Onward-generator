{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onward-generator.local/schemas/heights.overrides.schema.json",
  "title": "Authoritative building-height overrides",
  "description": "Heights or floor counts from authoritative open data (cadastre, LiDAR, official surveys). Every entry needs a traceable source and licence. An entry with only `levels` is converted with the category storey height.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "overrides"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "license"],
        "anyOf": [{ "required": ["height_m"] }, { "required": ["levels"] }],
        "properties": {
          "id": { "type": "string", "pattern": "^osm-(node|way|relation)-[0-9]+(:[A-Za-z0-9_.-]+)?$", "description": "An OSM building, or a Catastro sub-building <osm id>:<localId> written by cadastre split (ADR-015)" },
          "height_m": { "type": "number", "exclusiveMinimum": 0 },
          "levels": { "type": "integer", "minimum": 1 },
          "source": { "type": "string", "minLength": 3 },
          "license": { "type": "string", "minLength": 2 },
          "retrieved_at": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "note": { "type": "string" }
        }
      }
    }
  }
}
