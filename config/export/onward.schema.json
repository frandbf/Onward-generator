{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onward-generator.local/schemas/export/onward.schema.json",
  "title": "Onward export adapter configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "adapter", "target", "map", "build"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "0.1.0" },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "onward_unity" },
        "version": { "const": "0.1.0" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unity", "sdk", "platform"],
      "properties": {
        "unity": { "const": "2021.3.23f1" },
        "sdk": { "const": "1.15" },
        "platform": { "const": "quest" }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,40}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 600 }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["combine_cell_m", "static_batching", "occlusion_culling", "lightmap_texels_per_m", "lightmap_max_size", "lightmap_directional"],
      "properties": {
        "combine_cell_m": { "type": "number", "minimum": 0, "maximum": 1000 },
        "static_batching": { "type": "boolean" },
        "occlusion_culling": { "type": "boolean" },
        "lightmap_texels_per_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 40 },
        "lightmap_max_size": { "enum": [512, 1024, 2048, 4096] },
        "lightmap_directional": { "type": "boolean" },
        "lightmap_class_scales": {
          "description": "scaleInLightmap by surface class; a class left out keeps the default (roof 0.25, ground 0.5, interior 0.5, scenic 0.25, party 0.5, facade 1)",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "roof": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "ground": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "interior": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "scenic": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "party": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "facade": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        },
        "albedo_compression": {
          "description": "Android format of the albedo textures the adapter imports: astc_6x6 (default), or none for uncompressed RGBA32 as before",
          "enum": ["astc_6x6", "none"]
        },
        "interior_lights_max": { "type": "integer", "minimum": 0, "maximum": 256 },
        "interior_light_intensity": { "type": "number", "exclusiveMinimum": 0, "maximum": 4 },
        "fog_enabled": { "type": "boolean" },
        "fog_start_m": { "type": "number", "minimum": 0, "maximum": 3000 },
        "fog_end_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 3000 },
        "fog_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    }
  }
}
